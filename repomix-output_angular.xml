  preencherLinhasVazias(linhasUsadas: number): number[] {
    const maxLinhas = 10; // ou `this.parametros.limite`
    const faltantes = maxLinhas - linhasUsadas;
    return Array.from({ length: faltantes > 0 ? faltantes : 0 });
  }
    */
}

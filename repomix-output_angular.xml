    text-align: left;
    padding: 1rem;
  }

  td {
    padding: 1rem 1.2rem;
    border-bottom: 1px solid #ddd;
    text-align: center;
  }
  td.Nome {
    text-align: left;
  }

  tr:nth-child(even) {
    background-color: #e6f4ec;
    border-radius: 2rem;
    // tom suave esverdeado
  }

  tr:hover {
    background-color: #cce6d9;
  }
}

.tabela-customizada {
  width: 100vw; //usa o total do container pai
  border-collapse: collapse;
  font-size: 0.9rem;
  border-radius: 1rem;
  left: 1rem;
  //white-space: nowrap;
  thead {
    background-color: $primary-light;
    color: white;

    th {
      padding: 0.75rem;
      text-align: center;
      border-bottom: 2px solid adjust($primary-light, 10%);
    }
  }

  tbody {
    tr:nth-child(odd) {
      background-color: $primary-lightest;
    }

    tr:nth-child(even) {
      background-color: $primary-lighter;
    }

    td {
      padding: 0.75rem;
      //border-bottom: 1px solid adjust($primary-light, 20%);
    }
  }
}
.badge-status {
  font-size: 0.8rem;
  color: rgb(255, 255, 255);
  background-color: $primary;
  border-radius: 1rem;
  padding: 0.5rem;
  &.inativo {
    background-color: #4c4c4c;
  }
}
.page-item {
  //menu de navegação - página ativa
  &.disabled .page-link {
    pointer-events: none;
    opacity: 0.5;
  }

  &.active .page-link {
    background-color: $primary-light;
    color: white;
    border-color: $primary-light;
  }
}

.page-link {
  //menu de navegação - páginas não ativas
  display: inline-block;
  padding: 6px 12px;
  border: 1px solid #ddd;
  border-radius: 0.5rem;
  color: $primary-light;
  text-decoration: none;
  font-size: 1.25rem;
  background-color: white;
  transition: background-color 0.2s ease;

  &:hover {
    background-color: #e6f4ec;
  }
}
.container-paginacao {
  display: grid;
  grid-template-columns: 1fr 1fr 0.2fr;
}
.numero-usuarios {
  max-width: 10vw;
  display: flex;
  float: left;
  left: 1rem;
}
.pagination {
  cursor: pointer;
  display: flex;
  float: right;
  list-style: none;
  gap: 0.5rem;
  padding: 0;
  margin: 1rem 0;
  margin-top: 0.5rem;
  justify-content: right;
  flex-wrap: wrap;
  max-width: 30vw;
  right: 2rem;
}

.sem-dados {
  padding: 20px;
  text-align: center;
  color: #666;
}

.debug-container {
  margin-bottom: 20px;
  padding: 15px;
  background-color: #f5f5f5;
  border-radius: 4px;

  pre {
    margin: 0;
    white-space: pre-wrap;
  }
}
table.tabela-customizada tr.linha-vazia td {
  height: 2rem; // ajuste conforme o tamanho normal de uma linha
  background-color: transparent !important;
  border: none;
  pointer-events: none;
}

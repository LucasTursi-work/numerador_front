<file path="src/styles/styles.scss">
/* You can add global styles to this file, and also import other style files */
@use "colors" as *;
@import "normalize.css/normalize.css";

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
  overflow: hidden;
}
html,
body {
  height: 100%;
  margin: 0;
  padding: 0.1rem;
  overflow-y: auto;
  overflow: hidden; // Evita scroll
}
input {
  border-radius: 1rem;
  font-size: 1.5rem;
  width: 100%;
}

.separador-mini {
  height: 2vh;
  width: 5vw;
}

.separador {
  height: 4vh;
  width: 5vw;
}

.separador-big {
  height: 6vh;
  width: 5vw;
}

.button {
  color: $txt;
  border-color: none;
  background: $primary;
  border-radius: 0.5rem;
  padding: 0.25rem;
  padding-left: 1rem;
  padding-right: 1rem;
  margin: 0.5rem;
  margin-left: 0.5rem;
  margin-right: 0.5rem;
  //box-shadow: 4px 3px 4px darkgrey;
  border: none;
  font-size: 12px;
  font-weight: bold;

  &:hover {
    color: $accent;
    border-color: none;
    background-color: $primary-light;
    transform: scale(1.1);
    border-radius: 0.5rem;
    padding: 0.25rem;
    padding-left: 1rem;
    padding-right: 1rem;
    margin: 0.2rem;
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    //box-shadow: 8px 5px 6px gray;
    border: none;
  }
  &:focus {
    color: $txt;
    border-color: none;
    background: $primary-darkest;
    transform: scale(0.9);
    border-radius: 1rem;
    padding: 0.25rem;
    padding-left: 1rem;
    padding-right: 1rem;
    margin: 0.5rem;
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    box-shadow: none;
    border: none;
  }
}

input,
select {
  padding: 0.6rem;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 1rem;
  transition: border-color 0.2s;

  &:focus {
    outline: none;
    border-color: $primary-light;
    box-shadow: 0 0 0 2px rgba($primary-light, 0.2);
  }
}
/* Importing Bootstrap SCSS file. */
@import "bootstrap/scss/bootstrap";

/* Importing Bootstrap SCSS file. */
@import 'bootstrap/scss/bootstrap';

                <button id="bt_editar" (click)="onEditar(usuario)">
                  Editar
                </button>
                <button id="bt_excluir" (click)="onExcluir(usuario)">
                  Excluir
                </button>
              </div>
            </td>
          </tr>
          <!--
          <tr
            *ngFor="
              let i of preencherLinhasVazias(usuarios.length);
              index as idx
            "
            class="linha-vazia"
          >
        
            <td colspan="6">&nbsp;</td>
          </tr>
          -->
        </tbody>
      </table>
    </div>

    <div class="container-paginacao">
      <div class="numero-usuarios">Total: {{ totalElementos }} usuário(s)</div>

      <nav *ngIf="totalElementos > 0">
        <ul class="pagination">
          <!-- Botão Anterior -->
          <li class="page-item" [class.disabled]="paginaAtual <= 1">
            <a class="page-link" (click)="mudarPagina.emit(paginaAtual - 1)"
              >Anterior</a
            >
          </li>

          <!-- Números das páginas -->
          <li
            class="page-item"
            *ngFor="let i of [].constructor(totalPaginas); let index = index"
            [class.active]="paginaAtual === index + 1"
          >
            <a class="page-link" (click)="mudarPagina.emit(index + 1)">
              {{ index + 1 }}
            </a>
          </li>

          <!-- Botão Próxima -->
          <li class="page-item" [class.disabled]="paginaAtual >= totalPaginas">
            <a class="page-link" (click)="mudarPagina.emit(paginaAtual + 1)"
              >Próxima</a
            >
          </li>
        </ul>
      </nav>
    </div>
  </div>
</div>
